# Copy this file to .env — secrets are auto-generated on first run.
# Only POSTGRES_USER, POSTGRES_DB, and DOMAIN need manual values.
# Never commit .env to version control.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=        # leave blank — auto-generated by init-secrets.sh
POSTGRES_DB=financedb

JWT_SECRET=               # leave blank — auto-generated by init-secrets.sh

# Local:       localhost
# Production:  your-domain.com  (DNS A record must point to this server)
DOMAIN=localhost
